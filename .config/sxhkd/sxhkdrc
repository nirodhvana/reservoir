# Screenshots
Print
     sleep 0.2; \
     scrot -d3 $HOME/'Pictures/screenshots/%Y-%m-%d-%s_$wx$h.png';
     notify-send --urgency=low --hint=string:x-dunst-stack-tag:scrot 'Screenshot taken' 'Selection'

Control+Print
     sleep 0.2; \
     scrot -s $HOME/'Pictures/screenshots/%Y-%m-%d_%H%M%S-$wx$h.png'; \
     notify-send --urgency=low --hint=string:x-dunst-stack-tag:scrot 'Screenshot taken' 'Selection'


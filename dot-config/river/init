# Set keyboard options riverctl set-repeat 50 500
riverctl keyboard-layout en

# Set cursor options
riverctl hidecursor timeout 20
riverctl hidecursor when-typing enabled
riverctl focus-follows-cursor always
riverctl xcursor-theme Adwaita 36

# Set tiling and display options
riverctl default-layout wideriver
riverctl allow-tearing disabled
riverctl background-color 0x090604
riverctl border-color-focused 0xC9372A
riverctl border-color-unfocused 0x090604

wideriver \
                  --layout                       left        \
                  --layout-alt                   monocle     \
                  --stack                        dwindle     \
                  --count-master                 1           \
                  --ratio-master                 0.50        \
                  --count-wide-left              0           \
                  --ratio-wide                   0.35        \
                  --no-smart-gaps                            \
                  --inner-gaps                   12          \
                  --outer-gaps                   12          \
                  --border-width                 4           \
                  --border-width-monocle         0           \
                  --border-width-smart-gaps      0           \
                  --border-color-focused         ""  \
                  --border-color-focused-monocle ""  \
                  --border-color-unfocused       ""  \
                  --log-threshold                info        \
                 > "/tmp/wideriver.${XDG_VTNR}.${USER}.log" 2>&1 &

# Tag Management
for i in $(seq 1 9)
do
    tagmask=$((1 << ($i - 1)))
    riverctl map normal Super               $i set-focused-tags    $tagmask
    riverctl map normal Super+Shift         $i set-view-tags       $tagmask
    riverctl map normal Super+Control       $i toggle-focused-tags $tagmask
    riverctl map normal Super+Shift+Control $i toggle-view-tags    $tagmask
done
all_tags_mask=$(((1 << 32) - 1))
riverctl map normal Super       0 set-focused-tags $all_tags_mask
riverctl map normal Super+Shift 0 set-view-tags    $all_tags_mask

# The scratchpad will live on an unused tag. Which tags are used depends on your
# config, but rivers default uses the first 9 tags.
scratch_tag=$((1 << 20 ))

# Toggle the scratchpad with Super+P
riverctl map normal Super P toggle-focused-tags ${scratch_tag}

# Send windows to the scratchpad with Super+Shift+P
riverctl map normal Super+Shift P set-view-tags ${scratch_tag}

# Set spawn tagmask to ensure new windows don't have the scratchpad tag unless
# explicitly set.
all_but_scratch_tag=$(( ((1 << 32) - 1) ^ $scratch_tag ))
riverctl spawn-tagmask ${all_but_scratch_tag}

## Keybindings for the layouts
# Left, Dwindle
riverctl map normal Super D send-layout-cmd wideriver "--layout left --stack dwindle --count 1 --ratio 0.5"
# Right, Even
riverctl map normal Super R send-layout-cmd wideriver "--layout right --stack even --count 2 --ratio 0.55"
# Wide, Diminish
riverctl map normal Super W send-layout-cmd wideriver "--layout wide --stack diminish --count 3 --ratio 0.4"
# Monocle
riverctl map normal Super M send-layout-cmd wideriver "--layout monocle"

# Toggles between current and previous layout
riverctl map normal Super Space send-layout-cmd wideriver "--layout-toggle"

# Window resizing and moving
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_LEFT move-view

# Floating and tiling Windows
riverctl map-pointer normal Super BTN_MIDDLE toggle-float
riverctl map normal Super+Shift space toggle-float

# Full Screen
riverctl map normal Super F toggle-fullscreen

# Super+J and Super+K to focus the next/previous view in the layout stack
riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous

# Super+Shift+J and Super+Shift+K to swap the focused view with the next/previous view in the layout stack
riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous

# Super+Period and Super+Comma to focus the next/previous output
riverctl map normal Super Period focus-output next
riverctl map normal Super Comma focus-output previous

# Super+Return to bump the focused view to the top of the layout stack
riverctl map normal Super Backspace zoom

# Super+H and Super+L to decrease/increase the main ratio of wideriver(1)
riverctl map normal Super H send-layout-cmd wideriver "--ratio -0.05"
riverctl map normal Super L send-layout-cmd wideriver "--ratio +0.05"

# Super+Shift+H and Super+Shift+L to increment/decrement the main count of wideriver(1)
riverctl map normal Super+Shift H send-layout-cmd wideriver "--count +1"
riverctl map normal Super+Shift L send-layout-cmd wideriver "--count -1"

# Super+Alt+{H,J,K,L} to move views
riverctl map normal Super+Alt H move left 100
riverctl map normal Super+Alt J move down 100
riverctl map normal Super+Alt K move up 100
riverctl map normal Super+Alt L move right 100

# Super+Alt+Control+{H,J,K,L} to snap views to screen edges
riverctl map normal Super+Alt+Control H snap left
riverctl map normal Super+Alt+Control J snap down
riverctl map normal Super+Alt+Control K snap up
riverctl map normal Super+Alt+Control L snap right

# Mapping to close the focused view
riverctl map normal Super X close

# Mapping to exit river
riverctl map normal Super+Shift Q exit

# Keybindings for launching apps
riverctl map normal Super Return spawn foot
riverctl map normal Super Semicolon spawn "mew-launcher"
riverctl map normal Super+Shift F spawn pcmanfm
riverctl map normal Super+Shift B spawn librewolf
riverctl map normal Super+Shift G spawn gimp
riverctl map normal Super+Shift T spawn qbittorrent
riverctl map normal Super+Shift P spawn "~/.local/bin/harmonica &"
riverctl map normal Super+Alt P spawn "footclient -e "cd ~/Music && mpar.sh""
riverctl map normal Super+Alt F spawn "footclient -e "lf""
riverctl map normal Super+Alt N spawn "footclient -e "newsboat""
riverctl map normal Super+Alt A spawn "footclient -e "ani-cli""
riverctl map normal Super+Alt M spawn "footclient -e "mangal""
riverctl map normal Super+Control P spawn system-config-printer
riverctl map normal Super+Control S spawn simple-scan
riverctl map normal Super+Control B spawn blueman-manager
riverctl map normal None Print spawn "sleep 2 && grim ~/pictures/screenshots/$(date +%Y-%m-%d_%H%M%S).png && notify-send --urgency=low 'Screenshot taken' 'Full Screen'"
riverctl map normal Control Print spawn "slurp | grim -g - ~/pictures/screenshots/$(date +%Y-%m-%d_%H%M%S).png && notify-send --urgency=low 'Screenshot taken' 'selection'"
riverctl map normal Super+Shift L spawn "waylock -ignore-empty-password -init-color 0x2e5d66 -input-color 0x6d8d5f -input-alt-color 0xa5995e -fail-color 0xC9372A"
riverctl map normal Super+Control N spawn "footclient -e "nmtui""
riverctl map normal Super+Control E spawn "emacsclient -c"

# Enable Server Side Decoration to prevent gui border glitches.
riverctl rule-add ssd

# Custom window rules for programs.
riverctl rule-add -app-id gimp float
riverctl rule-add -app-id gimp dimensions 800 500
riverctl rule-add -app-id gimp position 500 400

bash $HOME/.local/bin/waystarter.sh
slstatus -s | dam

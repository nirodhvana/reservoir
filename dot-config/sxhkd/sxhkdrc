# Launch Firefox
super + shift + b
	librewolf ;

# Screenshots
Print
     sleep 0.2; \
     scrot -d3 $HOME/'Pictures/synced/screenshots/%Y-%m-%d-%s_$wx$h.png'; \
     notify-send --urgency=low --hint=string:x-dunst-stack-tag:scrot 'Screenshot taken' 'Selection'

ctrl+Print
     sleep 0.2; \
     scrot -s $HOME/'Pictures/synced/screenshots/%Y-%m-%d_%H%M%S-$wx$h.png'; \
     notify-send --urgency=low --hint=string:x-dunst-stack-tag:scrot 'Screenshot taken' 'Selection'

# Launch Terminal file manager
super + alt + f
     mlterm -e "lf";

# Launch GUI file manager
super + shift + f
     pcmanfm;

# Launch Thunderbird
super + shift + m
     thunderbird;

# Launch Lobster
super+alt+m
     mlterm -e "lobster";

# Launch RSS
super +alt + n
     mlterm -e "newsboat";

# Launch Printer
super + ctrl + p
     system-config-printer ;

# Launch Scanner
super + ctrl + s
     simple-scan ;

# Launch blueman
super + ctrl + b
     mlterm -e "bluetoothctl" ;

# Launch GIMP
super + shift + g
     gimp ;

# Launch Youtube-scraper in cli
super + alt + y
     mlterm -e "~/.local/scripts/yt" ;

# Launch qbittorrent
super + shift + t
     qbittorrent ;

# Launch ani-cli
super + alt + a
     mlterm -e "ani-cli" ;

# Launch mangal
super + alt + m
     mlterm -e "mangal" ;

# Launch Music
super + shift+ p
     ~/.local/bin/harmonica &

#Shuffling albums only
super + alt + p
     mlterm -e "cd ~/Music && mpar.sh" &

# Launch Slock
super + shift + l
     slock ;

# Network Manager
super + ctrl + n
     mlterm -e "nmtui"

# Emacsclient
super + ctrl + e
     emacsclient -c
